# Copy to .env and fill in what you need. .env is gitignored and never
# reaches the browser. Agent files reference these as ${VARS}.

# --- Always ------------------------------------------------------------------
# https://www.assemblyai.com/dashboard/api-keys
ASSEMBLYAI_API_KEY=

# Which file in agents/ to use. Usually passed on the command line instead,
# as in: AGENT=http-tools python publish.py
# AGENT=minimal

# `python publish.py` writes one of these per agent file, so agents/minimal.jsonc
# gets AGENT_ID_MINIMAL. Present means update that agent, absent means create
# one. Setting a bare AGENT_ID overrides all of them, which is what a hosted
# deployment or a dashboard-shaped agent wants.
# AGENT_ID=

# --- Phone: python deployment/telephony/connect.py ----------------------------------------------------
# From your Twilio console dashboard.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# A number you already own in Twilio, E.164.
# TWILIO_PHONE_NUMBER=+15551234567
# A SIP domain you pick. Globally unique, ends in .pstn.twilio.com.
# TWILIO_TRUNK_DOMAIN=my-company-agent.pstn.twilio.com

# --- Multi-tenant SaaS: python deployment/browser/server.py --------------------------------
# Twilio Connect App SID. Twilio Console -> Settings -> Connect applications ->
# create an app, then copy its SID. The Authorize URL on that app must be
# {CALLDESK_BASE_URL}/connect/twilio/callback.
# TWILIO_CONNECT_APP_SID=

# Your Twilio Account SID and Auth Token, from the console dashboard home page.
# The auth token is what reads a customer's number list through Twilio Connect.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# Public base URL of this CallDesk instance, no trailing slash. Twilio will not
# call back to localhost, so a real deploy needs its public https origin here.
# Used to build the TwiML URLs that route a call into the voice agent.
# CALLDESK_BASE_URL=https://your-app.onrender.com

# AssemblyAI agent id for CallDesk. `AGENT=calldesk python publish.py` writes
# this automatically, so you rarely set it by hand.
# AGENT_ID_CALLDESK=

# The SIP trunk that hands inbound calls to AssemblyAI. A number must already be
# on this trunk before AssemblyAI will accept it, so this gates /numbers/bind.
# Create one with deployment/telephony/connect.py.
# TWILIO_TRUNK_DOMAIN=my-company-agent.pstn.twilio.com

# Google OAuth 2.0 credentials, from Google Cloud Console -> APIs & Services ->
# Credentials -> Create credentials -> OAuth client ID -> Web application.
# Add {CALLDESK_BASE_URL}/auth/google/callback as an Authorized redirect URI.
# Both are needed, or the "Continue with Google" button reports that sign-in is
# not set up. Implemented in google_auth.py with no pip install.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Per agent ---------------------------------------------------------------
# Only needed by the agent that names them. Can live here, or beside the agent
# in agents/<name>.env, which is gitignored too.

# agents/exa-search.jsonc: https://dashboard.exa.ai
# EXA_API_KEY=

# agents/airtable-crm.jsonc: https://airtable.com/create/tokens
# AIRTABLE_API_KEY=
# AIRTABLE_BASE_ID=

# agents/cal-booking.jsonc: https://app.cal.com/settings/developer/api-keys
# CAL_API_KEY=
# CAL_EVENT_TYPE_ID=

# agents/dtmf.jsonc: your https endpoint, which receives the keypad digits
# DTMF_WEBHOOK_URL=
