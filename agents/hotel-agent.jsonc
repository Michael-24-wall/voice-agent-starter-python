// Hotel front desk: the inbound call assistant for a hotel or guesthouse.
//
// This file is the request body for POST /v1/agents. There is no wrapper and no
// field the API does not define. The base agent is published once with
// agent_manager.publish_user_agent(), which fills in {business_name} and the
// tool URLs, so each hotel gets its own agent rather than sharing one.
//
// https://www.assemblyai.com/docs/voice-agents/voice-agent-api/create-agent
{
  // {business_name} is replaced with the account's own name at publish time.
  // Left in, it would be read aloud as "curly braces business name".
  "name": "{business_name} Front Desk",

  // Read aloud, so short spoken sentences, no lists, no formatting.
  // The last line matters: the tools answer ok false with a plain reason, and
  // the agent has to say that reason rather than invent availability.
  // https://www.assemblyai.com/docs/voice-agents/voice-agent-api/prompting-guide
  "system_prompt": "You are the front desk for {business_name}, a hotel. Help callers check room availability and book rooms. Collect the guest name, phone number, check-in date, check-out date, and desired room type. Call check_availability before offering a room, then book_room to confirm. If a tool returns ok false, tell the caller exactly what went wrong in plain words and offer an alternative if the error names one. Never state a price, a room number, or an availability you did not get from a tool. Keep responses under 2 sentences. Do not make up information you were not given.",

  // Without a greeting the agent says nothing when the call connects, and
  // silence on a fresh line reads as a dropped call.
  // https://www.assemblyai.com/docs/voice-agents/voice-agent-api/greeting
  "greeting": "Thanks for calling {business_name}. How can I help you with your stay?",

  // Voice catalog: https://www.assemblyai.com/docs/voice-agents/voice-agent-api/voices
  // alba is US English. Immutable once a session starts, so it only affects
  // calls that begin after the change.
  "voice": { "voice_id": "alba" },

  "tools": [
    {
      // Read by the model to decide when to call it, so it says when to use
      // the tool, not just what the tool does.
      "name": "check_availability",
      "description": "Check which rooms are free for given check-in and check-out dates. Use before quoting a room or a price to a caller.",

      // interactive keeps the agent talking while the query runs, so a slow
      // or failing tool never reads as a dropped line. hold would silence the
      // agent until a result came back.
      // https://www.assemblyai.com/docs/voice-agents/voice-agent-api/tools/overview#execution-modes
      "execution_mode": "interactive",
      "timeout_seconds": 30,

      "parameters": {
        "type": "object",
        "properties": {
          // enum keeps the model to the room types a hotel actually lists
          // instead of inventing "penthouse suite".
          "room_type": { "type": "string", "enum": ["standard", "deluxe", "suite"] },
          "check_in": { "type": "string", "description": "Arrival date as YYYY-MM-DD" },
          "check_out": { "type": "string", "description": "Departure date as YYYY-MM-DD" }
        },
        "required": ["check_in", "check_out"]
      },

      // AssemblyAI makes this request, not the browser, so the tool also works
      // on a phone call. The URL must be a public https address: the API
      // rejects http:// outright, and 127.0.0.1 or localhost resolve on
      // AssemblyAI's own servers rather than on this machine.
      // ${CALLDESK_TOOL_BASE} is the /tool prefix, in .env so the tunnel
      // hostname can change without editing here. agent_manager falls back to
      // deriving it from CALLDESK_TOOL_URL.
      // https://www.assemblyai.com/docs/voice-agents/voice-agent-api/tools/http-tools
      "http": {
        "url": "${CALLDESK_TOOL_BASE}/check_availability",
        "http_method": "POST"
      }
    },
    {
      "name": "book_room",
      "description": "Book a specific room for a guest. Only call after check_availability confirmed the room is free for those dates.",

      "execution_mode": "interactive",
      "timeout_seconds": 30,

      "parameters": {
        "type": "object",
        "properties": {
          "room_number": { "type": "string", "description": "The room number from check_availability" },
          "guest_name": { "type": "string" },
          "guest_phone": { "type": "string" },
          "check_in": { "type": "string", "description": "Arrival date as YYYY-MM-DD" },
          "check_out": { "type": "string", "description": "Departure date as YYYY-MM-DD" }
        },
        "required": ["room_number", "guest_name", "guest_phone", "check_in", "check_out"]
      },

      "http": {
        "url": "${CALLDESK_TOOL_BASE}/book_room",
        "http_method": "POST"
      }
    }
  ]
}
